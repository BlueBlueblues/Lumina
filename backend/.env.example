# Server
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Set to true only when the backend is behind a trusted reverse proxy (Nginx).
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cloud sync (optional at boot; sync APIs return 503 when absent)
DATABASE_URL=postgres://lumina:change-me@127.0.0.1:5432/lumina
DATABASE_POOL_MAX=5

# AI provider (optional at boot; AI APIs return 503 when absent)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-chat
AI_TEMPERATURE=0.4
AI_RATE_LIMIT_PER_MINUTE=30

# Required in production: at least 16 random characters.
TOKEN_PEPPER=change-me-to-a-long-random-string
PAIRING_CODE_TTL_SECONDS=600
